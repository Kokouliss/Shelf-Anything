<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window behind Compose. Colors and type come from ShelfAnythingTheme. An AppCompat
         theme, because MainActivity is an AppCompatActivity. DayNight makes the window dark in dark
         mode, so a dark-mode start does not flash white before the first frame. -->
    <style name="Theme.ShelfAnything" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- The background of the app, so the start screen and the first frame have the same colour. -->
        <item name="android:windowBackground">@color/background</item>
    </style>
    <!-- The same value as BACKGROUND in core/domain Palette.kt. The dark one is in values-night. -->
    <color name="background">#F7F7FA</color>
    <!-- The dark tile of the app logo, the ink of the AnyKind logos. -->
    <color name="ic_launcher_background">#171A21</color>
</resources>
